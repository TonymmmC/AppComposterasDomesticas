{
  "name": "simulador-compostera",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador de nodo de sensado ESP32 + DHT22 / Humedad de sustrato para composteras domésticas",
  "type": "module",
  "scripts": {
    "start": "tsx src/simulador.ts",
    "dev": "tsx watch src/simulador.ts",
    "start:normal": "tsx src/simulador.ts --modo=normal",
    "start:humedad-baja": "tsx src/simulador.ts --modo=humedad_baja",
    "start:temp-alta": "tsx src/simulador.ts --modo=temperatura_alta"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
